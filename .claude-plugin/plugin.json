    "./platforms/claude/agents/planner.md",
    "./platforms/claude/agents/researcher.md",
    "./platforms/claude/agents/implementer.md",
    "./platforms/claude/agents/reviewer.md",
    "./platforms/claude/agents/tester.md",
    "./platforms/claude/agents/mascot.md"
