  "skills": [
    "./content/skills/common/file-length-policy/",
    "./content/skills/common/journal-management-generic/",
    "./content/skills/common/persona-free-documents/",
    "./content/skills/common/project-notes/",
    "./content/skills/common/retro/",
    "./content/skills/common/shell-discipline/",
    "./content/skills/common/simplified-technical-english/",
    "./content/skills/common/skill-resolution/",
    "./content/skills/implementer/code-implementation/",
    "./content/skills/implementer/python-quality-gates/",
    "./content/skills/implementer/react-quality-gates/",
    "./content/skills/implementer/rust-implementation/",
    "./content/skills/implementer/rust-quality-gates/",
    "./content/skills/orchestrator/commit-hygiene/",
    "./content/skills/orchestrator/journal-management/",
    "./content/skills/orchestrator/task-routing/",
    "./content/skills/planner/interview/",
    "./content/skills/planner/study/",
    "./content/skills/researcher/source-selection/",
    "./content/skills/reviewer/code-review-checklist/",
    "./content/skills/tester/production-issue-flagging/",
    "./content/skills/tester/regression-identification/",
    "./content/skills/tester/test-case-structure/",
    "./content/skills/tester/test-strategy-selection/"
