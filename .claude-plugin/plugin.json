  "hooks": "./platforms/claude/hooks/hooks.json",
  "userConfig": {
    "theme": {
      "type": "string",
      "title": "Persona theme",
      "description": "The crew whose personas the profession agents speak as",
      "options": [
        "catcrew",
        "caveman",
        "cyberpunk",
        "fantasy",
        "goblin",
        "pub",
        "wh40k",
        "wh40kOrk"
      ],
      "default": "goblin"
    }
  }
