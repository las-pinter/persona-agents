{
  "name": "persona-agents",
  "displayName": "Persona Agents",
  "description": "A companion agent that plans, builds, tests, and commits with you, in the voice of a switchable persona theme",
  "author": {
    "name": "Las Pinter"
  },
  "repository": "https://github.com/las-pinter/persona-agents",
  "license": "MIT",
  "keywords": [
    "agents",
    "personas",
    "companion"
  ],
  "agents": [
    "./platforms/claude/agents/companion.md",
    "./platforms/claude/agents/reviewer.md"
  ],
  "skills": [
    "./content/skills/code-implementation/",
    "./content/skills/code-review-checklist/",
    "./content/skills/commit-hygiene/",
    "./content/skills/file-length-policy/",
    "./content/skills/interview/",
    "./content/skills/journal-management/",
    "./content/skills/journal-management-generic/",
    "./content/skills/persona-free-documents/",
    "./content/skills/production-issue-flagging/",
    "./content/skills/project-notes/",
    "./content/skills/python-quality-gates/",
    "./content/skills/react-quality-gates/",
    "./content/skills/regression-identification/",
    "./content/skills/retro/",
    "./content/skills/review/",
    "./content/skills/rust-implementation/",
    "./content/skills/rust-quality-gates/",
    "./content/skills/session-notes/",
    "./content/skills/source-selection/",
    "./content/skills/study/",
    "./content/skills/test-case-structure/",
    "./content/skills/test-strategy-selection/"
  ],
  "hooks": "./platforms/claude/hooks/hooks.json",
  "userConfig": {
    "theme": {
      "type": "string",
      "title": "Persona theme",
      "description": "The theme whose persona the companion speaks as",
      "options": [
        "catcrew",
        "caveman",
        "cyberpunk",
        "fantasy",
        "goblin",
        "pub",
        "wh40k",
        "wh40kOrk"
      ],
      "default": "goblin"
    }
  }
}
