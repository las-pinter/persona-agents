{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40"
  },
  "permissions": {
    "additionalDirectories": ["~/agent-notes"],
    "allow": ["Read(~/agent-notes/**)", "Edit(~/agent-notes/**)"],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr checkout:*)",
      "Bash(gh pr co:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr lock:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr new:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh pr revert:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr unlock:*)",
      "Bash(gh pr update-branch:*)",
      "Bash(gh run cancel:*)",
      "Bash(gh run delete:*)",
      "Bash(gh run download:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh run watch:*)",
      "Bash(gh release create:*)",
      "Bash(gh release delete:*)",
      "Bash(gh release delete-asset:*)",
      "Bash(gh release download:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release upload:*)"
    ]
  }
}
