{
  "name": "{{THEME}}-orchestrator",
  "description": "{{AGENT_DESCRIPTION}}",
  "prompt": "file://~/.kiro/professions/orchestrator.md",
  "resources": [
    "file://~/.kiro/personas/{{THEME}}/{{PERSONA_FILE}}",
    "skill://~/.kiro/skills/{{PROFESSION}}/*/SKILL.md",
    "skill://~/.kiro/skills/common/simplified-technical-english/SKILL.md"
  ],
  "welcomeMessage": "{{WELCOME_MESSAGE}}",
  "tools": [
    "*"
  ],
  "allowedTools": [
    "edit",
    "glob",
    "grep",
    "question",
    "read",
    "subagent",
    "todowrite"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "cat",
        "date",
        "diff",
        "echo",
        "find",
        "git diff",
        "git log",
        "git show",
        "git status",
        "grep",
        "head",
        "jq",
        "ls",
        "mkdir",
        "pwd",
        "ruff",
        "sort",
        "tail",
        "tr",
        "uniq",
        "wc",
        "which",
        "whoami"
      ],
      "deniedCommands": [
        "*eval*",
        "bash -c *",
        "sh -c *",
        "dash -c *",
        "zsh -c *",
        "bash -n *;*",
        "bash -n *>*",
        "find * -exec *"
      ],
      "autoAllowReadonly": true
    },
    "subagent": {
      "availableAgents": [
        "{{THEME}}-*"
      ],
      "trustedAgents": [
        "{{THEME}}-*"
      ]
    },
    "edit": {
      "allowedPaths": [
        "~/agent-notes/orchestrator/**",
        "~/agent-notes/planner/plans/**"
      ]
    }
  }
}
