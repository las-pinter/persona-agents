    "file://~/.kiro/personas/{{THEME}}/{{PERSONA_FILE}}",
    "skill://~/.kiro/skills/{{PROFESSION}}/*/SKILL.md",
    "skill://~/.kiro/skills/common/project-notes/SKILL.md",
    "skill://~/.kiro/skills/common/simplified-technical-english/SKILL.md",
    "skill://~/.kiro/skills/common/journal-management-generic/SKILL.md",
    "skill://~/.kiro/skills/common/persona-free-documents/SKILL.md"
  ],
  "welcomeMessage": "{{WELCOME_MESSAGE}}",
  "tools": [
    "*"
  ],
  "allowedTools": [
    "edit",
    "glob",
    "grep",
    "question",
    "read",
    "subagent",
    "todowrite"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "cat",
        "date",
        "diff",
        "echo",
        "find",
        "gh --version",
        "gh auth status",
        "git cat-file",
        "git diff",
        "git log",
        "git rev-list",
        "git rev-parse",
        "git show",
        "git status",
        "git grep",
        "git describe",
        "git blame",
        "git annotate",
        "git shortlog",
        "git whatchanged",
        "git ls-files",
        "git ls-tree",
        "git show-ref",
        "git for-each-ref",
        "git name-rev",
        "git check-ignore",
        "git check-attr",
        "git check-ref-format",
        "git diff-tree",
        "git diff-index",
        "git diff-files",
        "git cherry",
        "git range-diff",
        "git var",
        "git version",
        "git help",
        "git show-branch",
        "git get-tar-commit-id",
        "git check-mailmap",
        "git patch-id",
        "git stripspace",
        "git column",
        "git count-objects",
        "git verify-commit",
        "git verify-tag",
        "git verify-pack",
        "git fsck",
        "git hash-object",
        "git hash-object --stdin",
        "git commit-graph verify",
