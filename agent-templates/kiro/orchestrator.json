{
  "name": "{{THEME}}-orchestrator",
  "description": "{{AGENT_DESCRIPTION}}",
  "prompt": "file://~/.kiro/professions/orchestrator.md",
  "resources": [
    "file://~/.kiro/personas/{{THEME}}/{{PERSONA_FILE}}",
    "skill://~/.kiro/skills/{{PROFESSION}}/*/SKILL.md",
    "skill://~/.kiro/skills/common/project-notes/SKILL.md",
    "skill://~/.kiro/skills/common/simplified-technical-english/SKILL.md"
  ],
  "welcomeMessage": "{{WELCOME_MESSAGE}}",
  "tools": [
    "*"
  ],
  "allowedTools": [
    "edit",
    "glob",
    "grep",
    "question",
    "read",
    "subagent",
    "todowrite"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "cat",
        "date",
        "diff",
        "echo",
        "find",
        "git diff",
        "git log",
        "git show",
        "git status",
        "grep",
        "head",
        "jq",
        "ls",
        "mkdir",
        "pwd",
        "ruff",
        "sort",
        "tail",
        "tr",
        "uniq",
        "wc",
        "which",
        "whoami"
      ],
      "deniedCommands": [
        "*eval*",
        "bash -c *",
        "sh -c *",
        "dash -c *",
        "zsh -c *",
        "bash -n *;*",
        "bash -n *>*",
        "find * -exec *",
        "git tag -d*",
        "* git tag -d*",
        "*;git tag -d*",
        "*&&git tag -d*",
        "*|git tag -d*",
        "*$(git tag -d*",
        "*`git tag -d*",
        "git tag --delete*",
        "* git tag --delete*",
        "*;git tag --delete*",
        "*&&git tag --delete*",
        "*|git tag --delete*",
        "*$(git tag --delete*",
        "*`git tag --delete*",
        "git tag -f*",
        "* git tag -f*",
        "*;git tag -f*",
        "*&&git tag -f*",
        "*|git tag -f*",
        "*$(git tag -f*",
        "*`git tag -f*",
        "git tag --force*",
        "* git tag --force*",
        "*;git tag --force*",
        "*&&git tag --force*",
        "*|git tag --force*",
        "*$(git tag --force*",
        "*`git tag --force*",
        "git tag * -d*",
        "git tag * --delete*",
        "git tag * -f*",
        "git tag * --force*",
        "* git tag * -d*",
        "*;git tag * -d*",
        "*&&git tag * -d*",
        "*|git tag * -d*",
        "*$(git tag * -d*",
        "*`git tag * -d*",
        "* git tag * -f*",
        "*;git tag * -f*",
        "*&&git tag * -f*",
        "*|git tag * -f*",
        "*$(git tag * -f*",
        "*`git tag * -f*",
        "git -C * tag -d*",
        "* git -C * tag -d*",
        "git -C * tag --delete*",
        "* git -C * tag --delete*",
        "git -C * tag -f*",
        "* git -C * tag -f*",
        "git -C * tag --force*",
        "* git -C * tag --force*",
        "*$(git -C * tag -d*",
        "*`git -C * tag -d*",
        "*;git -C * tag -d*",
        "*&&git -C * tag -d*",
        "*|git -C * tag -d*",
        "*$(git -C * tag --delete*",
        "*`git -C * tag --delete*",
        "*;git -C * tag --delete*",
        "*&&git -C * tag --delete*",
        "*|git -C * tag --delete*",
        "*$(git -C * tag -f*",
        "*`git -C * tag -f*",
        "*;git -C * tag -f*",
        "*&&git -C * tag -f*",
        "*|git -C * tag -f*",
        "*$(git -C * tag --force*",
        "*`git -C * tag --force*",
        "*;git -C * tag --force*",
        "*&&git -C * tag --force*",
        "*|git -C * tag --force*",
        "*git tag -*d*",
        "*git tag -*f*",
        "*git -C * tag -*d*",
        "*git -C * tag -*f*"
      ],
      "autoAllowReadonly": true
    },
    "subagent": {
      "availableAgents": [
        "{{THEME}}-*"
      ],
      "trustedAgents": [
        "{{THEME}}-*"
      ]
    },
    "edit": {
      "allowedPaths": [
        "~/agent-notes/orchestrator/**",
        "~/agent-notes/project-notes/**"
      ]
    }
  }
}
