        "git remote get-url",
        "git config --get",
        "git config --get-all",
        "git config --get-regexp",
        "git config --get-urlmatch",
        "git config -l",
        "git config --list",
        "git config --show-origin",
        "git config --show-scope",
        "git symbolic-ref HEAD",
        "git symbolic-ref --short HEAD",
        "git symbolic-ref -q HEAD",
        "git stash list",
        "git stash show",
        "git notes list",
        "git notes show",
        "git worktree list",
        "git submodule status",
        "git submodule summary",
        "git sparse-checkout list",
        "grep",
        "head",
        "jq",
        "ls",
        "mkdir",
        "pwd",
        "ruff",
        "sort",
        "tail",
        "tr",
        "uniq",
        "wc",
        "which",
        "whoami"
      ],
      "deniedCommands": [
        "*eval*",
        "bash -c *",
        "sh -c *",
        "dash -c *",
        "zsh -c *",
        "bash -n *;*",
        "bash -n *>*",
        "find * -exec *",
        "git tag -d*",
        "* git tag -d*",
        "*;git tag -d*",
        "*&&git tag -d*",
        "*|git tag -d*",
        "*$(git tag -d*",
        "*`git tag -d*",
        "git tag --delete*",
        "* git tag --delete*",
        "*;git tag --delete*",
        "*&&git tag --delete*",
        "*|git tag --delete*",
        "*$(git tag --delete*",
        "*`git tag --delete*",
        "git tag * -d*",
        "git tag * --delete*",
        "* git tag * -d*",
        "*;git tag * -d*",
        "*&&git tag * -d*",
        "*|git tag * -d*",
        "*$(git tag * -d*",
        "*`git tag * -d*",
        "git -C * tag -d*",
        "* git -C * tag -d*",
        "git -C * tag --delete*",
        "* git -C * tag --delete*",
        "*$(git -C * tag -d*",
        "*`git -C * tag -d*",
        "*;git -C * tag -d*",
        "*&&git -C * tag -d*",
        "*|git -C * tag -d*",
        "*$(git -C * tag --delete*",
        "*`git -C * tag --delete*",
        "*;git -C * tag --delete*",
        "*&&git -C * tag --delete*",
        "*|git -C * tag --delete*",
        "*git tag -*d*",
        "*git -C * tag -*d*"
      ],
      "autoAllowReadonly": false
    },
    "subagent": {
      "availableAgents": [
        "{{THEME}}-*"
      ],
      "trustedAgents": [
        "{{THEME}}-*"
      ]
    },
    "edit": {
      "allowedPaths": [
        "~/agent-notes/orchestrator/**",
        "~/agent-notes/project-notes/**"
      ]
    }
  }
