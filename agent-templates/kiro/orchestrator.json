{
  "name": "{{THEME}}-orchestrator",
  "description": "{{AGENT_DESCRIPTION}}",
  "prompt": "file://~/.kiro/professions/orchestrator.md",
  "resources": [
    "file://~/.kiro/personas/{{THEME}}/{{PERSONA_FILE}}",
    "skill://~/.kiro/skills/{{PROFESSION}}/*/SKILL.md"
  ],
  "welcomeMessage": "{{WELCOME_MESSAGE}}",
  "tools": [
    "*"
  ],
  "allowedTools": [
    "edit",
    "glob",
    "grep",
    "question",
    "read",
    "subagent",
    "todowrite"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "awk *",
        "bash -n *",
        "cat *",
        "date *",
        "diff *",
        "echo *",
        "find * -name *",
        "find * -type *",
        "git diff *",
        "git log *",
        "git show *",
        "git status *",
        "grep *",
        "head *",
        "jq *",
        "ls *",
        "mkdir *",
        "pwd",
        "ruff *",
        "sort *",
        "tail *",
        "tr *",
        "uniq *",
        "wc *",
        "which *",
        "whoami"
      ],
      "deniedCommands": [
        "bash -n *;*",
        "bash -n *>*",
        "find * -exec *",
        "git pull *",
        "git push *"
      ],
      "autoAllowReadonly": true
    },
    "subagent": {
      "availableAgents": [
        "{{THEME}}-*"
      ],
      "trustedAgents": [
        "{{THEME}}-*"
      ]
    },
    "edit": {
      "allowedPaths": [
        "~/agent-notes/orchestrator/**",
        "~/agent-notes/planner/plans/**"
      ]
    }
  }
}
