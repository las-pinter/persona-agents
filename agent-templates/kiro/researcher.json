{
  "name": "{{THEME}}-researcher",
  "description": "{{AGENT_DESCRIPTION}}",
  "prompt": "file://~/.kiro/professions/researcher.md",
  "resources": [
    "file://~/.kiro/personas/{{THEME}}/{{PERSONA_FILE}}",
    "skill://~/.kiro/skills/{{PROFESSION}}/*/SKILL.md"
  ],
  "welcomeMessage": "{{WELCOME_MESSAGE}}",
  "tools": [
    "@context7",
    "@deepwiki",
    "@exa",
    "edit",
    "external_directory",
    "glob",
    "grep",
    "read",
    "shell",
    "skill",
    "web_search"
  ],
  "allowedTools": [
    "@context7",
    "@deepwiki",
    "@exa",
    "edit",
    "external_directory",
    "glob",
    "grep",
    "read",
    "web_search"
  ],
  "toolsSettings": {
    "edit": {
      "allowedPaths": ["~/agent-notes/researcher/**"]
    },
    "external_directory": {
      "allowedPaths": ["~/agent-notes/researcher/**"]
    },
    "shell": {
      "allowedCommands": [
        "awk *",
        "cat *",
        "date *",
        "diff *",
        "echo *",
        "find * -name *",
        "find * -type *",
        "git branch *",
        "git diff *",
        "git log *",
        "git show *",
        "git status *",
        "grep *",
        "head *",
        "jq *",
        "ls *",
        "pwd",
        "sort *",
        "tail *",
        "tr *",
        "uniq *",
        "wc *",
        "which *"
      ],
      "deniedCommands": [
        "find * -exec *",
        "git pull *",
        "git push *"
      ],
      "autoAllowReadonly": true
    }
  },
  "includeMcpJson": true
}
