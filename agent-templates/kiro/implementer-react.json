{
  "name": "{{THEME}}-implementer-react",
  "description": "{{AGENT_DESCRIPTION}}",
  "prompt": "file://~/.kiro/professions/implementer-react.md",
  "resources": [
    "file://~/.kiro/personas/{{THEME}}/{{PERSONA_FILE}}",
    "skill://~/.kiro/skills/implementer/*/SKILL.md"
  ],
  "welcomeMessage": "{{WELCOME_MESSAGE}}",
  "tools": [
    "code",
    "edit",
    "glob",
    "grep",
    "read",
    "shell",
    "subagent",
    "write"
  ],
  "allowedTools": [
    "code",
    "glob",
    "grep",
    "read",
    "subagent"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "awk *",
        "bash -n *",
        "cat *",
        "date *",
        "diff *",
        "docker inspect *",
        "docker logs *",
        "docker ps *",
        "echo *",
        "find * -name *",
        "find * -type *",
        "git branch *",
        "git diff *",
        "git log *",
        "git show *",
        "git status *",
        "grep *",
        "head *",
        "jq *",
        "ls *",
        "node --version",
        "npm run *",
        "npm test *",
        "npx eslint *",
        "npx jest *",
        "npx prettier *",
        "pwd",
        "rg *",
        "sort *",
        "tail *",
        "tr *",
        "uniq *",
        "wc *",
        "which *"
      ],
      "deniedCommands": [
        "bash -n *;*",
        "bash -n *>*",
        "find * -exec *",
        "git pull *",
        "git push *"
      ],
      "autoAllowReadonly": true
    },
    "subagent": {
      "availableAgents": [
        "{{THEME}}-researcher"
      ],
      "trustedAgents": [
        "{{THEME}}-researcher"
      ]
    }
  }
}
