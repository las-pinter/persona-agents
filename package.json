{
  "name": "persona-agents",
  "version": "4.2.0",
  "description": "Pi package: agent orchestration with per-agent frontmatter permissions, personas, and subagents",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./platforms/pi/extension/extension.ts"],
    "skills": ["./content/skills/**/SKILL.md"],
    "prompts": ["./content/commands/*.md"]
  },
  "scripts": {
    "lint": "shellcheck install.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-reporter=dot --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=/tmp/persona-agents-test.log \"platforms/pi/extension/*.test.ts\" \"tests/*.test.ts\"",
    "test:permissions": "node --experimental-strip-types --test platforms/pi/extension/command-segments.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^22",
    "typebox": "1.3.27",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@earendil-works/pi-codemode": "1.1.0"
  },
  "dependencies": {},
  "engines": {
    "node": ">=22.6"
  }
}
