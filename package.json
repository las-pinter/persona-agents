{
  "name": "companion-agents",
  "version": "6.1.1",
  "description": "A persona companion agent with skills, project notes, and session logs, for Claude Code, Pi, and Kiro CLI",
  "private": true,
  "type": "module",
  "keywords": [
    "claude-code-plugin",
    "pi-package",
    "kiro-cli"
  ],
  "scripts": {
    "lint": "shellcheck install.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-reporter=dot --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=/tmp/companion-agents-test.log \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6.0"
  },
  "dependencies": {},
  "pi": {
    "extensions": ["./platforms/pi/extensions/index.ts"],
    "skills": ["./content/skills"]
  },
  "engines": {
    "node": ">=22.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": ">=1.5.0"
  }
}
